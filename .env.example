# Profile: primary
AUTOPILOT_KEY_PRIMARY=sk-ant-...
AUTOPILOT_MODEL_PRIMARY=claude-sonnet-5

# Profile: sonnet45  (borrowed key)
AUTOPILOT_KEY_SONNET45=sk-ant-...
AUTOPILOT_MODEL_SONNET45=claude-sonnet-4-5-20250929

# Gemini API key used by GeminiPlanner (autopilot/ai_planner.py) for the
# `interactive` subcommand only - separate from the AUTOPILOT_KEY_* Anthropic
# profiles above.
GEMINI_API_KEY=
# GeminiPlanner tries a built-in priority chain of models (best rate-limit
# headroom first) and automatically switches to the next one if the current
# model gets rate-limited - no setup needed. Only set these if your key's
# available models/limits differ from the built-in defaults:
# AUTOPILOT_GEMINI_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash-lite,gemini-2.5-flash
# AUTOPILOT_GEMINI_MODEL=gemini-2.5-flash          # pin a single model instead of the chain
# AUTOPILOT_GEMINI_MIN_INTERVAL_S=12                # force one pacing interval for every model