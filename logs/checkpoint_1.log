from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path

from anthropic import Anthropic
from rich.console import Console

from autopilot.config import (
    AppConfig,
    Profile,
    RuntimeConfig,
    Settings,
    load_app_config,
    load_scenario,
    resolve_profile,
)

console = Console()


def validate_api_key(profile: Profile) -> None:
    client = Anthropic(api_key=profile.api_key, max_retries=0)
    try:
        resp = client.messages.create(
            model=profile.model,
            max_tokens=16,
            messages=[{"role": "user", "content": "ping"}],
        )
        console.print(f"[green]API validation passed[/green] -- model: {profile.model}")
    except Exception as e:
        console.print(f"[red]API validation failed[/red] -- model: {profile.model}")
        console.print(f"[red]Error: {e}[/red]")
        sys.exit(1)


def build_runtime_config(
    app_config: AppConfig,
    profile: Profile,
    scenario_path: Path | None = None,
) -> RuntimeConfig:
    scenario = None
    if scenario_path:
        scenario = load_scenario(scenario_path)
    return RuntimeConfig(app=app_config, profile=profile, scenario=scenario)


def cmd_validate_only(args: argparse.Namespace) -> int:
    settings = Settings()
    try:
        profile = resolve_profile(settings, cli_profile=args.profile)
    except ValueError as e:
        console.print(f"[red]{e}[/red]")
        return 2

    validate_api_key(profile)
    return 0


def cmd_run(args: argparse.Namespace) -> int:
    console.print("[yellow]Run command not yet implemented[/yellow]")
    return 0


def cmd_observe(args: argparse.Namespace) -> int:
    console.print("[yellow]Observe command not yet implemented[/yellow]")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(prog="autopilot", description="Autonomous web journey agent")
    parser.add_argument("--profile", help="API profile to use (primary, sonnet45)")
    parser.add_argument("--validate-only", action="store_true", help="Validate API key and exit")

    subparsers = parser.add_subparsers(dest="command", required=False)

    subparsers.add_parser("run", help="Run a journey").add_argument(
        "--scenario", type=Path, help="Scenario YAML file"
    )
    subparsers.add_parser("observe", help="Observe a page").add_argument("--url", required=True)

    args = parser.parse_args()

    env_profile = os.environ.get("AUTOPILOT_PROFILE")

    if args.validate_only:
        return cmd_validate_only(args)

    if args.command == "run":
        return cmd_run(args)
    elif args.command == "observe":
        return cmd_observe(args)
    else:
        parser.print_help()
        return 0


if __name__ == "__main__":
    sys.exit(main())
